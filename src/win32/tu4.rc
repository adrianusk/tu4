// tu4 Win32 resource script (windres / llvm-windres compatible)
#include <winresrc.h>

/////////////////////////////////////////////////////////////////////////////
// Application icon. The icon with the lowest ID is used as the app icon
// (taskbar / alt-tab / explorer).
1 ICON "tu4.ico"

/////////////////////////////////////////////////////////////////////////////
// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ASCII Dragon / xu4 Team\0"
            VALUE "FileDescription", "TU4 - Ultima IV Text Mode\0"
            VALUE "FileVersion", "1.0\0"
            VALUE "InternalName", "tu4\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 ASCII Dragon; (c) 2002-2022 xu4 Team\0"
            VALUE "OriginalFilename", "tu4.exe\0"
            VALUE "ProductName", "TU4 Ultima IV Text Mode\0"
            VALUE "ProductVersion", "1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
