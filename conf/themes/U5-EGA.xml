<?xml version="1.0"?>
<themefrag>
    <imageset name="U5-EGA">
        <!-- Tiles: 256 tiles, 4x4 characters each, serialized in MYSHAPES.ASP
             Each tile = 32 bytes. Tile N starts at byte offset N*32 (after 7-byte header).
             Subimage not needed here; indexed by tile number directly. -->
        <image name="tiles" filename="U5-EGA/MYSHAPES.ASP" width="4" height="4"
               filetype="image/x-asp-tiles" tiles="256"/>

        <!-- Character set (256 char+attr pairs for text rendering) -->
