    <tileanimset name="U5-EGA">
        <!-- Water/lava/fields: shift character rows vertically -->
        <tileanim name="scroll">
            <transform type="scroll"/>
        </tileanim>

        <!-- NPC/creature frame alternation (up to 4 frames) -->
        <tileanim name="frame" random="50">
            <transform type="frame"/>
        </tileanim>

        <!-- Guard: slower frame alternation -->
        <tileanim name="slow_frame" random="5">
            <transform type="frame"/>
        </tileanim>

        <!-- City flag: character alteration at flag position -->
        <tileanim name="cityflag" random="50">
            <transform type="char_alt" x="3" y="2" altchar="253"/>
        </tileanim>

        <!-- LCB flag: character alteration at flag position -->
        <tileanim name="lcbflag" random="50">
            <transform type="char_alt" x="3" y="1" altchar="253"/>
        </tileanim>

        <!-- Castle flag: character alteration at flag position -->
        <tileanim name="castleflag" random="50">
            <transform type="char_alt" x="3" y="1" altchar="253"/>
        </tileanim>

        <!-- Ship flag: character alteration only on West/East facing -->
        <tileanim name="shipflag" random="50">
            <context type="frame" frame="0">
                <transform type="char_alt" x="2" y="1" altchar="135"/>
            </context>
            <context type="frame" frame="1">
                <!-- North: no animation -->
            </context>
            <context type="frame" frame="2">
                <transform type="char_alt" x="3" y="1" altchar="253"/>
            </context>
            <context type="frame" frame="3">
                <!-- South: no animation -->
            </context>
        </tileanim>

        <!-- Pirate flag: character alteration only on West/East facing -->
        <tileanim name="pirateflag" random="50">
            <context type="frame" frame="0">
                <transform type="char_alt" x="2" y="1" altchar="135"/>
            </context>
            <context type="frame" frame="1">
                <!-- North: no animation -->
            </context>
            <context type="frame" frame="2">
                <transform type="char_alt" x="3" y="1" altchar="253"/>
            </context>
            <context type="frame" frame="3">
                <!-- South: no animation -->
            </context>
        </tileanim>

        <!-- Campfire: character alteration (flicker) -->
        <tileanim name="campfire" random="30">
            <transform type="char_alt" x="2" y="3" altchar="5"/>
        </tileanim>

        <!-- Phantom: frame animation with random (flicker effect) -->
        <tileanim name="phantom_flicker">
            <transform type="frame" random="50"/>
        </tileanim>
    </tileanimset>
</themefrag>
